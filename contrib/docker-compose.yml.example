services:
  app:
    image: fusiondirectory_debian:latest
    container_name: fusiondirectory
#    restart: unless-stopped
    restart: no
    ports:
      - "127.0.0.1:8080:2180"
    logging:
      driver: syslog
      options:
        tag: "{{.DaemonName}}.{{.Name}}"
    environment:
        TZ: Europe/Tallinn
        CONFIG_CHECK: 0
# SMTP settings are optional. Only if sending mail from fusiondirectory is needed
        SMTP_MAILHUB: smtp.isp.fqn
        SMTP_PORT: 25
        SMTP_MAILDOMAIN: myhost.isp.fqn
        SMTP_MAILHOST: myhost.isp.fqn
        SMTP_MAILFROMDOMAIN: isp.fqn
    volumes:
      - type: bind
        source: /var/log/my_containers/fusiondirectory
        target: /var/log/apache2
      - type: bind
        source: /opt/my_containers/fusiondirectory/etc/fusiondirectory
        target: /etc/fusiondirectory
      - type: bind
        source: /opt/my_containers/fusiondirectory/etc/ldap
        target: /home/apache2/ldap
        read_only: true
